{
  "name": "shelf-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SHELF frontend — React + TypeScript + Vite, embedded into the Go binary",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.66.0",
    "@tanstack/react-virtual": "3.13.0",
    "lucide-react": "0.474.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.1.5",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@fontsource/archivo": "5.2.6",
    "@playwright/test": "1.50.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.19.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "msw": "2.7.0",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  }
}
