# herdr 세션 실행기(.agents/bin/herdr-session)가 읽는 프로젝트 설정. `harness sync`는 이 파일을 덮어쓰지 않는다.

# 1: 권한 확인 없이 도는 자율 모드(claude --dangerously-skip-permissions, codex --yolo).
# 운영 자원·비밀에 닿는 프로젝트는 0으로 둔다. 0이면 권한 확인에서 세션이 멈추므로 자율주행이 끊긴다.
HERDR_AUTONOMOUS=1

# 동시에 띄울 수 있는 워커 수
HERDR_MAX_WORKERS=5

# 소프트 신호와 auto-compact 임계(토큰). 1M 창 모델 기준이다. 200K 창 모델을 쓰면 낮춘다.
HERDR_SOFT_SIGNAL_TOKENS=300000
HERDR_COMPACT_TOKENS=400000

# 역할별 에이전트(codex | claude)와 모델·effort. Commander·Orchestrator는 세션을 띄울 때 도구를 생략하고 이 값을 따른다.
# 비워 두면 띄우는 쪽이 도구를 인자로 정하고, 모델·effort는 실행기의 기본 표를 쓴다.
# 모델·effort는 도구가 같은 줄의 *_TOOL과 같을 때만 쓴다(검증자를 다른 도구로 띄우면 그 도구의 기본 표를 쓴다).
# 기본 표: codex Commander·Orchestrator gpt-6.1-terra/medium, 워커 gpt-6.1-sol/high
#          claude Commander sonnet/medium, Orchestrator opus/high, 워커 opus/medium
HERDR_COMMANDER_TOOL=codex
HERDR_COMMANDER_MODEL=
HERDR_COMMANDER_EFFORT=
HERDR_ORCHESTRATOR_TOOL=claude
HERDR_ORCHESTRATOR_MODEL=opus
HERDR_ORCHESTRATOR_EFFORT=high
HERDR_WORKER_TOOL=claude
HERDR_WORKER_MODEL=sonnet
HERDR_WORKER_EFFORT=medium
# 독립 검증자(verifier-*). 작성자(워커)와 다른 도구, 상위 모델·high effort를 권한다. 도구가 비어 있으면 워커 설정을 쓴다.
HERDR_VERIFIER_TOOL=codex
HERDR_VERIFIER_MODEL=gpt-6.1-sol
HERDR_VERIFIER_EFFORT=high

# 1: Orchestrator·워커를 띄울 때 Commander 패널(--here로 띄운 herdr 패널) 옆을 나눠 보기 전용(hc attach --observe)으로 붙인다.
# 세션이 끝나면 패널도 닫힌다. 0이면 백그라운드로만 띄운다.
HERDR_VIEW_PANES=1

# 검사 명령. 하네스는 언어별 설정을 담지 않으므로 프로젝트가 정한다. AGENTS.md의 "검사 명령"과 맞춘다.
# HERDR_CHECK_CMD: 전체 검사(린트·타입·테스트). 워커의 [완료]는 이것이 지금 HEAD에서 통과해야 보내진다(herdr-report 관문).
#                  비어 있으면 막지 않고 보고에 "검사 미설정"을 붙인다.
# HERDR_CHECK_FILE_CMD: 편집 직후 고친 파일만 보는 빠른 검사(린트·포맷 확인). {files}에 파일 목록이 들어간다.
#                  없으면 끝에 붙인다. 테스트는 넣지 않는다(편집마다 돈다). 비어 있으면 편집 hook은 아무것도 하지 않는다.
# HERDR_CHECK_TIMEOUT: 검사 한 번의 시간 제한(초)
# 예: HERDR_CHECK_CMD="npm run lint && npm run typecheck && npm test"
#     HERDR_CHECK_FILE_CMD="npx eslint --no-warn-ignored {files}"
HERDR_CHECK_CMD="{ [ -d web/node_modules ] || (cd web && pnpm install --frozen-lockfile --prefer-offline); } && make lint && make test && make web-gates"
HERDR_CHECK_FILE_CMD="\"${HERDR_HOME:-.}/scripts/check/quick-check.sh\" {files}"
HERDR_CHECK_TIMEOUT=1800

# 동시에 띄울 수 있는 독립 검증자 수. 검증 대기열이 길면 늘린다. 검증자도 검사를 돌리므로 기계 자원을 함께 본다
HERDR_MAX_VERIFIERS=1

# HERDR_CHECK_SKIP_PATHS: 바뀌어도 전체 검사 결과에 영향이 없는 경로(glob, 공백으로 구분, *는 /도 넘는다).
# 마지막 PASS 이후 바뀐 파일이 모두 여기에 맞으면 검사를 다시 돌리지 않고 그 PASS를 이어받는다.
# 검사가 그 파일을 읽으면(문서 링크 검사, 문서에서 코드 생성 등) 넣지 않는다. 비우면 이어받지 않는다.
# 예: HERDR_CHECK_SKIP_PATHS="docs/* *.md"
HERDR_CHECK_SKIP_PATHS=

# HERDR_CHECK_HEAVY_CMD: 전체 검사의 무거운 단계(테스트·e2e·빌드). HERDR_CHECK_CMD(가벼운 단계: 린트·타입)가 통과한 뒤
# 이 기계의 모든 프로젝트가 함께 쓰는 대기열(.agents/bin/herdr-queue) 아래서 돈다. 비우면 HERDR_CHECK_CMD만 돈다.
# 시간 제한은 두 단계의 실행 시간에만 걸고, 대기열에서 기다린 시간은 세지 않는다.
# 예: HERDR_CHECK_CMD="npm run lint && npm run typecheck"
#     HERDR_CHECK_HEAVY_CMD="npm test && npm run e2e"
HERDR_CHECK_HEAVY_CMD=

# 무거운 단계를 동시에 몇 개 돌릴지(기계 전체). 프로젝트마다 다르게 두면 각자 자기 값으로 자리를 센다
HERDR_HEAVY_SLOTS=1

# 시작 가드: 자리를 얻은 뒤 가용 메모리(GB)가 이 값 이상, 1분 부하가 이 값 미만이 될 때까지 기다린다. 0이면 보지 않는다
HERDR_HEAVY_MIN_MEM_GB=0

HERDR_HEAVY_MAX_LOAD=0

# HERDR_CHECK_AFFECTED_CMD: 바뀐 파일에 영향을 받는 검사만 돌리는 명령(영향 검사). {files}에 작업이 기본 브랜치와 갈라진 뒤
# 바뀐 파일(지운 파일 포함)이 들어간다. 있으면 일반 작업의 [완료] 관문은 전체 검사 대신 이것을 돌리고, 전체 검사(전체 회귀)는
# 병합 뒤 기본 브랜치 HEAD에서 뒤에서 한 번 돈다(연달은 병합은 한 번에 덮는다). 실패하면 Orchestrator에 알린다.
# 끝 코드: 0 통과, 1 실패, 4 영향 범위를 정할 수 없음(의존성 목록·빌드 설정 변경 등). 4면 전체 검사로 돌린다.
# 바꾼 코드, 그 코드를 가져다 쓰는 코드, 그 둘의 테스트만 고른다. 고르는 방법은 언어마다 다르다:
#   Go: go list로 바뀐 패키지에 의존하는(테스트 포함) 패키지를 모아 go vet·go test
#   JS/TS: vitest related --run {files}, jest --findRelatedTests {files}, 타입 검사는 프로젝트 전체(타입은 파일을 넘는다)
#   Python: pytest --testmon, 또는 바뀐 모듈을 가져다 쓰는 테스트 파일
#   셸 스크립트: bash -n, shellcheck, 그 스크립트를 부르는 테스트
# 비우면 영향 검사를 하지 않는다(관문은 전체 검사).
# 예: HERDR_CHECK_AFFECTED_CMD="scripts/affected-check.sh {files}"
HERDR_CHECK_AFFECTED_CMD=

# 경량 작업([배정]에 `등급: 경량`)의 상한. 바뀐 줄(추가+삭제)이 이 수를 넘으면 경량 관문을 쓰지 않고 전체 검사로 돌린다
HERDR_LIGHT_MAX_LINES=150

# HERDR_LIGHT_DENY_PATHS: 바뀌면 경량으로 볼 수 없는 경로(glob, 공백으로 구분, *는 /도 넘는다). 데이터·마이그레이션·인증·
# 공개 계약·배포처럼 작게 바꿔도 위험한 곳을 적는다. 경량 작업이 이 경로를 바꾸면 전체 검사로 돌린다.
# 예: HERDR_LIGHT_DENY_PATHS="migrations/* */auth/* api/openapi.yaml deploy/*"
HERDR_LIGHT_DENY_PATHS=
