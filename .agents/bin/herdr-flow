#!/usr/bin/env python3
"""작업이 어디서 기다렸는지 잰다. 하네스가 남긴 기록만 읽는다.

  herdr-flow                    # 작업별 흐름과 검사 요약
  herdr-flow --since 2026-11-09
  herdr-flow --tsv              # 작업별 흐름만 탭 구분(초 단위)

기록(~/.claude/herdr/handoff/<프로젝트>/):
  received.tsv  워커가 [배정]·[병합]·[검증]을 받은 시각(worker-turn hook)
  reports.tsv   보낸 보고(herdr-report). [판정]은 결과와 SHA
  checks.tsv    전체 검사의 결과·실행 시간·대기열에서 기다린 시간(herdr-check). 이어받음은 INHERIT

작업별 구간:
  작업       [배정]을 받고 첫 [완료]까지
  관문 대기  첫 [완료]부터 [병합]을 받을 때까지. 검사·독립 검증·병합 순서를 기다린 시간이다
  병합       [병합]을 받고 그 뒤 마지막 [완료]까지
검사는 [완료]·[판정]에 적힌 SHA로 작업에 붙인다. 작업 ID는 말머리 바로 뒤 첫 낱말이다.
"""
import argparse
import datetime as dt
import os
import subprocess
import sys

SCHEMAS = {
    "received": ("epoch", "time", "role", "session_id", "tag", "task"),
    "reports": ("epoch", "time", "role", "session_id", "tag", "task", "sha", "result"),
    "checks": ("epoch", "time", "role", "session_id", "sha", "result", "seconds", "queue_s"),
}


def project_name():
    if os.environ.get("HERDR_PROJECT"):
        return os.environ["HERDR_PROJECT"]
    try:
        common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                capture_output=True, text=True, check=True).stdout.strip()
        return os.path.basename(os.path.dirname(common))
    except (OSError, subprocess.CalledProcessError):
        return os.path.basename(os.getcwd())


def read(handoff, name, since):
    """열 순서로 읽는다. 예전 머리글에 없던 뒤쪽 열도 받는다."""
    rows = []
    try:
        with open(os.path.join(handoff, f"{name}.tsv"), encoding="utf-8") as f:
            lines = f.read().splitlines()[1:]
    except OSError:
        return rows
    for line in lines:
        values = line.split("\t")
        row = dict(zip(SCHEMAS[name], values + [""] * (len(SCHEMAS[name]) - len(values))))
        try:
            row["epoch"] = int(row["epoch"])
        except ValueError:
            continue
        if since is None or row["epoch"] >= since:
            rows.append(row)
    rows.sort(key=lambda r: r["epoch"])
    return rows


def dur(seconds):
    if seconds is None:
        return "-"
    seconds = int(seconds)
    h, rest = divmod(seconds, 3600)
    m, s = divmod(rest, 60)
    return f"{h}h{m:02d}m" if h else (f"{m}m{s:02d}s" if m else f"{s}s")


def clock(epoch):
    return dt.datetime.fromtimestamp(epoch).strftime("%m-%d %H:%M") if epoch else "-"


def main():
    ap = argparse.ArgumentParser(description="작업 흐름과 대기 측정")
    ap.add_argument("--project", help="프로젝트 이름(기본: HERDR_PROJECT 또는 메인 체크아웃 폴더 이름)")
    ap.add_argument("--since", help="이 시각 이후 기록만(ISO, 시간대가 없으면 현지 시각)")
    ap.add_argument("--tsv", action="store_true", help="작업별 흐름을 탭 구분으로(초 단위, 머리글 포함)")
    a = ap.parse_args()

    since = None
    if a.since:
        try:
            t = dt.datetime.fromisoformat(a.since.replace("Z", "+00:00"))
        except ValueError:
            sys.exit(f"--since 형식을 읽지 못했다: {a.since}")
        since = int((t if t.tzinfo else t.astimezone()).timestamp())
    project = a.project or project_name()
    handoff = os.path.join(os.path.expanduser("~"), ".claude", "herdr", "handoff", project)
    received, reports, checks = (read(handoff, n, since) for n in ("received", "reports", "checks"))
    if not (received or reports or checks):
        sys.exit(f"기록이 없다: {handoff}/{{received,reports,checks}}.tsv\n하네스를 sync한 뒤 새로 띄운 세션부터 쌓인다.")

    tasks, order, sha_task = {}, [], {}

    def task(name):
        if name not in tasks:
            tasks[name] = {"assigned": None, "first_done": None, "merge_order": None, "last_done": None,
                           "verdicts": [], "checks": 0, "check_s": 0}
            order.append(name)
        return tasks[name]

    for r in received:
        if not r["task"]:
            continue
        t = task(r["task"])
        if r["tag"] == "배정" and t["assigned"] is None:
            t["assigned"] = r["epoch"]
        elif r["tag"] == "병합" and t["merge_order"] is None:
            t["merge_order"] = r["epoch"]
    for r in reports:
        if not r["task"] or r["tag"] not in ("완료", "판정"):
            continue
        t = task(r["task"])
        if r["sha"]:
            sha_task.setdefault(r["sha"], r["task"])
        if r["tag"] == "판정":
            if r["result"]:
                t["verdicts"].append(r["result"])
            continue
        if r["role"].startswith("verifier"):
            continue
        if t["first_done"] is None:
            t["first_done"] = r["epoch"]
        if t["merge_order"] is not None and r["epoch"] >= t["merge_order"]:
            t["last_done"] = r["epoch"]

    def owner(sha):
        for known, name in sha_task.items():
            if sha and (known.startswith(sha) or sha.startswith(known)):
                return name
        return None

    by_role, unmatched = {}, 0
    for c in checks:
        try:
            secs = int(c["seconds"] or 0)
        except ValueError:
            secs = 0
        try:
            queued = int(c["queue_s"] or 0)
        except ValueError:
            queued = 0
        s = by_role.setdefault(c["role"], {"n": 0, "PASS": 0, "FAIL": 0, "INHERIT": 0, "total": 0, "max": 0, "queue": 0})
        s["queue"] += queued
        s["n"] += 1
        s[c["result"]] = s.get(c["result"], 0) + 1
        s["total"] += secs
        s["max"] = max(s["max"], secs)
        name = owner(c["sha"])
        if name:
            tasks[name]["checks"] += 1
            tasks[name]["check_s"] += secs
        else:
            unmatched += 1

    def span(x, y):
        return y - x if x is not None and y is not None else None

    rows = []
    for name in order:
        t = tasks[name]
        rows.append((name, t, span(t["assigned"], t["first_done"]), span(t["first_done"], t["merge_order"]),
                     span(t["merge_order"], t["last_done"])))

    if a.tsv:
        print("task\twork_s\tgate_wait_s\tmerge_s\tchecks\tcheck_s\tverdicts")
        for name, t, work, gate, merge in rows:
            print("\t".join([name] + ["" if v is None else str(v) for v in (work, gate, merge)]
                            + [str(t["checks"]), str(t["check_s"]), ">".join(t["verdicts"])]))
        return

    print(f"프로젝트 {project} · 작업 {len(rows)}개 · 보고 {len(reports)}건 · 받은 지시 {len(received)}건 · 검사 {len(checks)}회")
    head = ["작업", "배정", "첫 완료", "병합 지시", "작업", "관문 대기", "병합", "검사", "검사 시간", "판정"]
    table = [[name, clock(t["assigned"]), clock(t["first_done"]), clock(t["merge_order"]), dur(work), dur(gate), dur(merge),
              str(t["checks"]), dur(t["check_s"]), ">".join(t["verdicts"]) or "-"] for name, t, work, gate, merge in rows]
    show(head, table, left=1)
    gates = [g for _, _, _, g, _ in rows if g is not None]
    if gates:
        print(f"관문 대기 합계 {dur(sum(gates))} · 평균 {dur(sum(gates) / len(gates))} · 최대 {dur(max(gates))} ({len(gates)}개 작업)")
    print()
    head = ["역할", "검사", "PASS", "FAIL", "이어받음", "합계", "평균", "최대", "대기열"]
    table = [[role, str(s["n"]), str(s["PASS"]), str(s["FAIL"]), str(s["INHERIT"]), dur(s["total"]),
              dur(s["total"] / max(s["n"] - s["INHERIT"], 1)), dur(s["max"]), dur(s["queue"])]
             for role, s in sorted(by_role.items())]
    if table:
        show(head, table, left=1)
    notes = ["'-'는 기록이 없는 구간이다. [배정]·[병합] 수신은 이 기능이 들어간 하네스로 띄운 워커부터 남는다.",
             "검사 시간은 실행 시간이고 평균은 이어받음을 뺀 실제 실행의 평균이다. 공용 대기열(herdr-queue)에서 기다린 시간은 '대기열'에 따로 센다.",
             "프로젝트 검사 명령 안에서 직접 잡는 잠금의 대기는 검사 시간에 들어 있다."]
    if unmatched:
        notes.append(f"작업에 붙이지 못한 검사 {unmatched}회(그 SHA로 보낸 [완료]·[판정]이 없다).")
    print("\n".join(notes))


def show(head, table, left):
    widths = [max(len(r[i]) for r in [head] + table) for i in range(len(head))]
    for r in [head] + table:
        print("  ".join(c.ljust(w) if i < left else c.rjust(w) for i, (c, w) in enumerate(zip(r, widths))).rstrip())


if __name__ == "__main__":
    main()
