#!/usr/bin/env bash
# 보기 패널: Commander 패널이 있는 herdr 탭을 나눠 hc 세션에 붙인다.
# 보기 전용(--observe)은 크기를 바꾸지 않아 hc 기본 크기(200x120)로 그린 화면이 작은 패널에서 겹쳐 깨진다.
# 그래서 일반 접속으로 붙어 세션 크기를 패널에 맞춘다. 패널은 포커스 없이 만들어 입력이 새지 않는다.
# 첫 패널은 기준 패널 오른쪽에, 다음부터는 보기 패널 중 가장 높은 것을 아래로 나눈다.
# 세션이 끝나면 hc attach가 끝나고 패널의 셸도 exit로 닫힌다.
# 사용: herdr-view <기준 패널 ID> <hc 주소> <role>
set -euo pipefail
[[ $# -eq 3 ]] || { echo "사용: herdr-view <기준 패널 ID> <hc 주소> <role>" >&2; exit 2; }
ANCHOR="$1" ADDR="$2" ROLE="$3"
PREFIX="hc:"
command -v herdr >/dev/null || { echo "보기 패널: herdr가 없어 건너뛴다" >&2; exit 1; }

panes="$(herdr pane list)" || { echo "보기 패널: herdr에 연결하지 못했다" >&2; exit 1; }
tab="$(jq -r --arg a "$ANCHOR" '.result.panes[] | select(.pane_id == $a) | .tab_id' <<<"$panes")"
[[ -n "$tab" ]] || { echo "보기 패널: 기준 패널 $ANCHOR 가 없다(닫혔을 수 있다). 건너뛴다" >&2; exit 1; }

# 같은 세션의 보기 패널이 이미 있으면 새로 만들지 않는다(세션 재사용).
label="$PREFIX$ROLE"
if jq -e --arg t "$tab" --arg l "$label" '.result.panes[] | select(.tab_id == $t and .label == $l)' <<<"$panes" >/dev/null; then
  exit 0
fi

views="$(jq -r --arg t "$tab" --arg p "$PREFIX" '.result.panes[] | select(.tab_id == $t and ((.label // "") | startswith($p))) | .pane_id' <<<"$panes")"
if [[ -z "$views" ]]; then
  target="$ANCHOR" direction=right
else
  layout="$(herdr pane layout --pane "$ANCHOR")"
  target="$(jq -r --arg v "$views" '($v | split("\n")) as $ids
    | [.result.layout.panes[] | select(.pane_id as $i | $ids | index($i))]
    | max_by(.rect.height) | .pane_id' <<<"$layout")"
  direction=down
fi

new="$(herdr pane split "$target" --direction "$direction" --no-focus | jq -r '.result.pane.pane_id // empty')"
[[ -n "$new" ]] || { echo "보기 패널: 패널을 나누지 못했다" >&2; exit 1; }
herdr pane rename "$new" "$label" >/dev/null
herdr pane run "$new" "hc attach $ADDR; exit" >/dev/null
echo "보기 패널: $new ($label → $ADDR)" >&2
