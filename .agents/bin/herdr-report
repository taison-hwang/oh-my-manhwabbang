#!/usr/bin/env bash
# 보고 대상에게 메시지를 보내고 보고 기록을 남긴다. 실행기가 PATH에 넣으므로 어느 폴더에서나 쓴다.
#   herdr-report "[완료] A-01 <요약>"
#   herdr-report --bg "[완료] A-01 <요약>"   검사를 뒤에서 돌리고 PASS면 [완료]를 자동으로 보낸다
#   herdr-report "[병합완료] A-01 <SHA> <요약>"   기본 브랜치에 들어간 SHA를 알린다. 그 SHA의 검사 PASS 기록을 붙이고,
#                                                기록이 없으면 그 SHA를 뒤에서 검사해 PASS면 보낸다
# 보고 대상: 워커 → Orchestrator, Orchestrator → Commander. 찾지 못하면 실패로 끝낸다.
# 맥락 크기와 compact 횟수는 hook이 남긴 값을 자동으로 붙인다. Orchestrator가 세션 장부에 옮겨 적는다.
# 워커의 [완료]는 보내기 전에 관문을 거친다: 커밋 안 된 변경이 없고 검사(herdr-check)가 지금 HEAD에서
# 통과해야 보내며, 결과를 "검사 PASS <SHA>"로 붙인다. 검사 명령이 없으면 막지 않고 "검사 미설정"을 붙인다.
# --bg: 지금 HEAD를 역할별 검사용 worktree에서 뒤에서 검사한다. 곧바로 "[진행] <작업> 커밋 <SHA> 검사 중(뒤에서) 예상 …"을
# 보내고, PASS면 그 SHA로 [완료]를 보낸다. FAIL이면 [완료]를 보내지 않고 이 세션과 Orchestrator에 알린다.
# 그동안 이 worktree에서 같은 묶음의 다음 작업을 이어 할 수 있다(검사는 커밋된 SHA만 본다).
# 영향 검사(HERDR_CHECK_AFFECTED_CMD가 있을 때): 일반 작업의 [완료] 관문은 기본 브랜치와 갈라진 뒤 바뀐 파일에 영향을 받는
# 검사만 돌린다(herdr-check --affected). 붙는 표시는 "영향 검사 PASS <SHA>"다. 명령이 없으면 전체 검사다.
# 경량 작업([배정]에 `등급: 경량`): [완료]는 바뀐 파일만 빠르게 검사(herdr-check --light)하고 보낸다. 바뀐 줄이
# HERDR_LIGHT_MAX_LINES를 넘거나 HERDR_LIGHT_DENY_PATHS의 경로를 바꿨으면 일반 관문으로 돌린다.
# 영향·경량 검사만 거친 SHA의 [병합완료]는 바로 보내고, 기본 브랜치 HEAD의 전체 검사(전체 회귀)를 뒤에서 돌린다.
# 병합 뒤 전체 검사는 프로젝트에 하나씩 차례로 돌고, 차례가 왔을 때 기본 브랜치 HEAD를 검사하므로 연달은 병합은 한 번에 덮는다.
# 실패하면 Orchestrator에 "[진행] <작업> 병합 뒤 전체 검사 FAIL <SHA>"를 보낸다. 기록은 역할 merged에 남는다.
# 독립 검증([배정]에 `독립 검증:` 항목이 있는 일반 작업): [완료]는 그 패치의 판정 PASS(herdr-verify)가 있어야 가고,
# "독립 검증 PASS <SHA> <기록>"을 붙인다. 판정이 없으면 --bg처럼 검사와 검증 서브에이전트를 함께 뒤에서 돌리고 둘 다 PASS면
# [완료]를 보낸다. ISSUES·BLOCKED면 [완료]를 보내지 않고 이 세션에 [판정]을, Orchestrator에 [진행]을 보낸다.
# 메인 체크아웃에서 보내는 워커의 [완료]는 커밋된 HEAD만 본다. 다른 세션의 변경이 섞여 있으므로 그 자리에서 검사하지 않고,
# PASS 기록이 없으면 --bg처럼 깨끗한 검사용 worktree에서 검사한다.
set -uo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mode=fg
case "${1:-}" in
  --bg) mode=bg; shift ;;
  --bg-run) mode=run; bg_sha="${2:-}"; shift 2 ;;
esac
[[ $# -eq 1 && -n "$1" ]] || { echo '사용법: herdr-report [--bg] "[완료|병합완료|진행|답변|차단|CLEAR 요청] <내용>"' >&2; exit 2; }
: "${HERDR_ROLE:?HERDR_ROLE이 없다. herdr-session으로 띄운 세션에서 쓴다}"
: "${HERDR_PROJECT:?HERDR_PROJECT가 없다. herdr-session으로 띄운 세션에서 쓴다}"

find_role() { # 같은 역할이 둘 이상이면(교체 중) 가장 최근에 띄운 세션
  local all t best="" bestms=-1 ms
  all="$(hc ls --json --label "project=$HERDR_PROJECT" --label "role=$1" | jq -r '.terminals[].address')"
  [[ "$(printf '%s\n' "$all" | grep -c .)" -le 1 ]] && { printf '%s' "$all"; return; }
  for t in $all; do
    ms="$(hc get "$t" --json 2>/dev/null | jq -r '.created_ms // 0')"
    [[ "${ms:-0}" -gt "$bestms" ]] && { best="$t"; bestms="${ms:-0}"; }
  done
  printf '%s' "$best"
}

case "$HERDR_ROLE" in
  commander) echo "Commander의 보고 대상은 사용자다. 화면에 직접 답한다." >&2; exit 2 ;;
  orchestrator) want=commander ;;
  *) want=orchestrator ;;
esac
message="$1"
dir="$HOME/.claude/herdr/handoff/$HERDR_PROJECT"
mkdir -p "$dir"
check="$BIN/herdr-check"
HERDR_LIGHT_MAX_LINES=150 HERDR_LIGHT_DENY_PATHS=""
eval "$( [[ -f "$BIN/../harness.env" ]] && . "$BIN/../harness.env" >/dev/null 2>&1; declare -p HERDR_LIGHT_MAX_LINES HERDR_LIGHT_DENY_PATHS 2>/dev/null)"

send() { # 메시지. 보고 대상에게 보내고 보고 기록을 남긴다
  local message="$1" target parent tokens compacts meta tag task sha result
  target="$(find_role "$want")"
  if [[ -z "$target" ]]; then
    parent="$(hc get "${HC_TERMINAL_ID:-}" 2>/dev/null | jq -r '.parent // empty')"
    [[ -n "$parent" ]] && target="$parent"
  fi
  if [[ -z "$target" && "$want" == orchestrator ]]; then
    target="$(find_role commander)"
    [[ -n "$target" ]] && message="[차단] Orchestrator 없음. 원래 보고: $message"
  fi
  [[ -n "$target" ]] || { echo "보고 대상($want)을 찾지 못했다." >&2; return 1; }

  tokens="$(cat "$dir/.$HERDR_ROLE.ctx" 2>/dev/null || true)"
  compacts="$(cat "$dir/.$HERDR_ROLE.compacts" 2>/dev/null || echo 0)"
  meta="$HERDR_ROLE ${HC_TERMINAL_ID:-}"
  [[ -n "$tokens" ]] && meta="$meta · ctx $((tokens / 1000))k"
  meta="$meta · compact $compacts"

  hc send "$target" "$message ($meta)" >/dev/null || { echo "$target 에 보내지 못했다." >&2; return 1; }
  # 턴 종료 hook이 이 턴의 보고로 센다. 뒤에서 도는 검사의 자동 보고는 세지 않는다(그사이 세션이 하던 턴의 보고가 아니다)
  [[ $mode == run ]] || date +%s >"$dir/.$HERDR_ROLE.reported"
  # 사용량 집계(herdr-usage)가 사용량을 작업에 붙이도록 보낸 보고의 경계를 남긴다. 실패해도 보고는 이미 갔다.
  {
    tag="${message#\[}"; tag="${tag%%\]*}"
    task="${message#*\] }"; task="${task%% *}"
    [[ "$message" == "["*"] "* ]] || { tag=""; task=""; }
    tag="${tag//$'\t'/ }"; task="${task//$'\t'/ }"; task="${task%%$'\n'*}"
    sha=""; result=""
    [[ "$message" =~ 검사\ PASS\ ([0-9a-f]+) ]] && sha="${BASH_REMATCH[1]}"
    [[ "$tag" == 병합완료 && -z "$sha" && "$message" =~ ^\[병합완료\]\ [^\ ]+\ ([0-9a-f]{7,40}) ]] && sha="${BASH_REMATCH[1]}"
    [[ "$message" =~ 독립\ 검증\ (PASS) ]] && result="${BASH_REMATCH[1]}"
    [[ -s "$dir/reports.tsv" ]] || printf 'epoch\ttime\trole\tsession_id\ttag\ttask\tsha\tresult\n' >"$dir/reports.tsv"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$(date +%Y-%m-%dT%H:%M:%S%z)" "$HERDR_ROLE" \
      "$(cat "$dir/.$HERDR_ROLE.session" 2>/dev/null)" "$tag" "$task" "$sha" "$result" | tr -d '\r' >>"$dir/reports.tsv"
  } 2>/dev/null || true
  echo "보냄: $want($target)"
}

task_of() { local t="${1#*\] }"; printf '%s' "${t%% *}"; }

state_label() { # 검사 기록 → 보고에 붙일 표시
  case "$1" in
    AFFECTED\ *) printf '영향 검사 PASS %s' "${1#AFFECTED }" ;;
    LIGHT\ *) printf '가벼운 검사 PASS %s(경량)' "${1#LIGHT }" ;;
    *) printf '검사 PASS %s' "${1#PASS }" ;;
  esac
}

after_merge() { # 병합한 SHA. 기본 브랜치의 전체 검사를 뒤에서 돌린다
  local detach=(nohup)
  command -v setsid >/dev/null && detach=(setsid nohup)
  HERDR_BG_AFTER_MERGE=1 "${detach[@]}" "$BIN/herdr-report" --bg-run "$1" "$message" \
    >"$dir/.$HERDR_ROLE.merged-${1:0:12}.out" 2>&1 </dev/null &
}

verify_of() { # 작업 ID → 이 역할이 받은 마지막 [배정]이 독립 검증을 요구하면 "필요"
  awk -F'\t' -v r="$HERDR_ROLE" -v t="$1" '$3 == r && $5 == "배정" && $6 == t { v = $8 } END { print v }' "$dir/received.tsv" 2>/dev/null
}

verify_label() { # herdr-verify --status 결과 → 보고에 붙일 표시
  local rest="${1#* }"
  local sha="${rest%% *}"
  printf '독립 검증 PASS %s %s' "${sha:0:12}" "${rest#* }"
}

grade_of() { # 작업 ID → 이 역할이 받은 마지막 [배정]의 등급(경량|일반)
  local g
  g="$(awk -F'\t' -v r="$HERDR_ROLE" -v t="$1" '$3 == r && $5 == "배정" && $6 == t { g = $7 } END { print g }' "$dir/received.tsv" 2>/dev/null)"
  printf '%s' "${g:-일반}"
}

light_over() { # 기준 커밋. 경량 기준을 넘으면 이유를 출력한다
  local mb lines f glob
  mb="$(git merge-base "$1" HEAD)" || { echo "기준과 갈라진 곳을 찾지 못함"; return; }
  lines="$(git diff --numstat "$mb" HEAD | awk '{ n += $1 + $2 } END { print n + 0 }')"
  [[ "$lines" -le "$HERDR_LIGHT_MAX_LINES" ]] || { echo "바뀐 줄 ${lines}줄 > HERDR_LIGHT_MAX_LINES ${HERDR_LIGHT_MAX_LINES}"; return; }
  set -f
  while IFS= read -r f; do
    for glob in $HERDR_LIGHT_DENY_PATHS; do
      # shellcheck disable=SC2254
      case "$f" in $glob) set +f; echo "경량 금지 경로 $f($glob)"; return ;; esac
    done
  done < <(git diff --no-renames --name-only "$mb" HEAD)
  set +f
}

predict() { # 지난 실제 검사(PASS) 시간으로 예상을 만든다
  awk -F'\t' 'NR > 1 && $6 == "PASS" && $7 + 0 > 0 { s[n++] = $7 + 0 }
    END {
      if (!n) { print "미상(지난 검사 기록 없음)"; exit }
      from = n > 20 ? n - 20 : 0; m = 0
      for (i = from; i < n; i++) if (s[i] > m) m = s[i]
      printf "최대 %dm(지난 PASS %d회 중)", int((m + 59) / 60), n - from
    }' "$dir/checks.tsv" 2>/dev/null || echo "미상(지난 검사 기록 없음)"
}

prepare_wt() { # 경로 SHA. 이 저장소의 검사용 worktree를 그 SHA로 맞춘다. 다른 저장소의 것이 남아 있으면 새로 만든다
  local wt="$1" sha="$2" mine
  mine="$(git rev-parse --path-format=absolute --git-common-dir)"
  git worktree prune 2>/dev/null
  if [[ -e "$wt/.git" && "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$mine" ]]; then
    git -C "$wt" checkout -q --force --detach "$sha" && git -C "$wt" clean -fdq
  else
    rm -rf "$wt" && git worktree add -q --detach "$wt" "$sha"
  fi
}

if [[ $mode == run ]]; then
  # 뒤에서 도는 검사. 역할별 검사용 worktree를 그 SHA로 맞춰 검사하고 결과대로 보낸다.
  wt="${XDG_CACHE_HOME:-$HOME/.cache}/herdr/check/$HERDR_PROJECT/$HERDR_ROLE"
  short="${bg_sha:0:12}" task="$(task_of "$message")"
  if [[ -n "${HERDR_BG_AFTER_MERGE:-}" ]]; then
    # 병합 뒤 전체 검사: 프로젝트에 하나씩, 차례가 오면 기본 브랜치 HEAD를 검사한다(그 사이 병합도 함께 덮는다)
    wt="${XDG_CACHE_HOME:-$HOME/.cache}/herdr/check/$HERDR_PROJECT/_merged"
    mkdir -p "$(dirname "$wt")"
    exec 9>"$wt.lock"
    command -v flock >/dev/null && flock 9
    main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
    head="$(git -C "$main" rev-parse HEAD)"
    git merge-base --is-ancestor "$bg_sha" "$head" || head="$bg_sha" # 기본 브랜치가 되돌려졌으면 병합한 SHA를 본다
    state="$(HERDR_ROLE=merged "$check" --status-of "$head")"
    # 이미 전체 검사를 통과했거나, 병합 뒤 검사가 이미 실패를 알린 SHA면 다시 돌지 않는다
    if [[ "$state" == PASS\ * ]] || awk -v k="$head" '$1 == "FAIL" && $2 == k { f = 1 } END { exit !f }' "$dir/.merged.check" 2>/dev/null; then
      echo "병합 뒤 전체 검사 생략: ${head:0:12}에 이미 기록이 있다($state)"; exit 0
    fi
    export HERDR_CHECK_LOG="$dir/.merged.check-${head:0:12}.log"
    prepare_wt "$wt" "$head" || { echo "검사용 worktree를 $head 로 맞추지 못했다" >"$HERDR_CHECK_LOG"; rc=1; }
    [[ -n "${rc:-}" ]] || { (cd "$wt" && HERDR_ROLE=merged "$check"); rc=$?; }
    case $rc in
      0 | 3) echo "병합 뒤 전체 검사 끝(${head:0:12}, 끝 코드 $rc)" ;;
      *) send "[진행] $task 병합 뒤 전체 검사 FAIL ${head:0:12}(기본 브랜치, $short 포함). 기본 브랜치가 깨졌을 수 있다. 로그: $HERDR_CHECK_LOG" ;;
    esac
    exit 0
  fi
  export HERDR_CHECK_LOG="$dir/.$HERDR_ROLE.check-$short.log"
  vpid=""
  if [[ -n "${HERDR_BG_VERIFY:-}" ]]; then
    # 독립 검증 서브에이전트는 검사와 서로의 결과를 쓰지 않으므로 함께 돌린다. 검사가 실패하면 취소한다
    vout="$dir/.$HERDR_ROLE.verify-$short.out"
    "$BIN/herdr-verify" --sha "$bg_sha" "$task" >"$vout" 2>&1 </dev/null &
    vpid=$!
  fi
  mkdir -p "$(dirname "$wt")"
  exec 9>"$wt.lock"
  command -v flock >/dev/null && flock 9 # 같은 역할의 뒤 검사는 차례로 돈다
  prepare_wt "$wt" "$bg_sha" || { echo "검사용 worktree를 $bg_sha 로 맞추지 못했다" >"$HERDR_CHECK_LOG"; rc=1; }
  if [[ -z "${rc:-}" ]]; then
    # 작업 worktree의 [완료]는 기본 브랜치와 갈라진 뒤의 변경만 영향 검사한다(설정이 없으면 전체 검사)
    if [[ -n "${HERDR_BG_BASE:-}" ]]; then (cd "$wt" && "$check" --affected "$HERDR_BG_BASE"); else (cd "$wt" && "$check"); fi; rc=$?
  fi
  case $rc in
    0 | 3)
      if [[ $rc -eq 0 ]]; then label="$(state_label "$(cd "$wt" && "$check" --status)")"; else label="검사 미설정"; fi
      if [[ -n "$vpid" ]]; then
        wait "$vpid"; vrc=$?
        vstate="$("$BIN/herdr-verify" --status --sha "$bg_sha" "$task" 2>/dev/null)"
        case "$vstate" in
          PASS\ *) label="$label · $(verify_label "$vstate")" ;;
          ISSUES\ * | BLOCKED\ *)
            vres="${vstate%% *}" vrec="${vstate##* }"
            if [[ $vres == ISSUES ]]; then
              note="기록의 차단 지적을 고쳐 커밋하고 herdr-report --bg로 다시 보낸다(지적 항목과 고친 부분만 다시 본다). 지적이 틀렸다고 보면 근거 명령과 출력을 herdr-verify --focus로 넘겨 다시 판정받는다."
            else
              note="검증을 실행하지 못했다. 기록의 이유를 풀 수 있으면 풀고 다시 보내고, 아니면 [차단]으로 올린다."
            fi
            [[ -n "${HC_TERMINAL_ID:-}" ]] && hc send "$HC_TERMINAL_ID" "[판정] $task $vres $short $vrec — ${message%%\]*}]를 보내지 않았다. $note" >/dev/null
            send "[진행] $task 커밋 $short 독립 검증 $vres, 작성 세션이 고치는 중"
            exit 0 ;;
          *)
            why="$(tail -n 3 "$vout" 2>/dev/null | tr '\n' ' ')"
            [[ $vrc -eq 5 ]] && why="검증 횟수 초과. 남은 지적과 반박 근거를 적어 [차단]으로 올린다"
            [[ -n "${HC_TERMINAL_ID:-}" ]] && hc send "$HC_TERMINAL_ID" "[판정] $task 없음 $short — ${message%%\]*}]를 보내지 않았다. 독립 검증이 판정을 남기지 못했다(끝 코드 $vrc): $why 출력: $vout" >/dev/null
            send "[진행] $task 커밋 $short 독립 검증 실패(판정 없음), 작성 세션이 확인 중"
            exit 0 ;;
        esac
      fi
      send "$message · $label" ;;
    *) [[ -n "$vpid" ]] && { kill -TERM "$vpid" 2>/dev/null; wait "$vpid" 2>/dev/null; }
       tag="${message%%\]*}]"
       note="[검사 FAIL] $task 커밋 $short — $tag를 보내지 않았다. 로그: $HERDR_CHECK_LOG"
       note="$note. 고친 뒤 커밋해 herdr-report --bg로 다시 보낸다. 이 커밋 위에 쌓은 작업이 있으면 worker.md의 '쌓은 작업 옮기기'를 따른다."
       [[ -n "${HC_TERMINAL_ID:-}" ]] && hc send "$HC_TERMINAL_ID" "$note" >/dev/null
       send "[진행] $task 커밋 $short 검사 FAIL, 작성 세션이 고치는 중" ;;
  esac
  exit 0
fi

start_bg() { # SHA [영향 검사 기준] [verify]. 그 SHA를 뒤에서 검사(와 독립 검증)하고 결과대로 보낸다. 기준이 없으면 전체 검사
  local sha="$1" task ahead detach what=검사
  task="$(task_of "$message")"
  [[ -n "${3:-}" ]] && what="검사·독립 검증"
  ahead="$("$BIN/herdr-queue" ahead 2>/dev/null || echo 0)"
  send "[진행] $task 커밋 ${sha:0:12} ${what} 중(뒤에서) 예상 $(predict) · 대기열 ${ahead}건" || exit 1
  detach=(nohup); command -v setsid >/dev/null && detach=(setsid nohup) # 턴이 끝나도 검사가 살아 있게 한다
  HERDR_BG_BASE="${2:-}" HERDR_BG_VERIFY="${3:-}" "${detach[@]}" "$BIN/herdr-report" --bg-run "$sha" "$message" >"$dir/.$HERDR_ROLE.bg-${sha:0:12}.out" 2>&1 </dev/null &
  echo "${what}를 뒤에서 돌린다(${sha:0:12}). 모두 PASS면 ${message%%\]*}]가 자동으로 가고, 아니면 이 세션에 알림이 온다."
}

gated=0
[[ ("$message" == "[완료]"* || "$message" == "[병합완료]"*) && "$HERDR_ROLE" != orchestrator ]] && gated=1
if [[ $gated -eq 1 ]]; then
  git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "${message%%\]*}]는 작업한 git 저장소 안에서 보낸다." >&2; exit 1; }
  common="$(git rev-parse --path-format=absolute --git-common-dir)"
  linked=0
  [[ "$(git rev-parse --path-format=absolute --git-dir)" != "$common" ]] && linked=1
  if [[ "$message" == "[병합완료]"* ]]; then
    # 병합한 SHA가 메인 체크아웃의 HEAD에 들어갔는지 보고, 그 SHA의 검사 기록을 붙인다
    rest="${message#\[병합완료\] }"; rest="${rest#* }"; given="${rest%% *}"
    [[ "$given" =~ ^[0-9a-f]{7,40}$ ]] || { echo '사용법: herdr-report "[병합완료] <작업 ID> <병합한 SHA> <요약>"' >&2; exit 2; }
    target_sha="$(git rev-parse --verify --quiet "$given^{commit}")" || { echo "커밋을 찾지 못했다: $given" >&2; exit 1; }
    main_head="$(git -C "$(dirname "$common")" rev-parse HEAD)"
    git merge-base --is-ancestor "$target_sha" "$main_head" || {
      echo "$given 이 메인 체크아웃의 HEAD(${main_head:0:12})에 없다. 병합한 뒤 보낸다." >&2; exit 1; }
  else
    if [[ $linked -eq 1 && -n "$(git status --porcelain)" ]]; then
      echo "커밋 안 된 변경이 있어 [완료]를 보내지 않았다. 커밋하거나 정리한 뒤 다시 보낸다:" >&2
      git status --short >&2
      exit 1
    fi
    target_sha="$(git rev-parse HEAD)"
    if [[ $linked -eq 0 ]]; then
      [[ -n "$(git status --porcelain)" ]] && echo "메인 체크아웃의 커밋 안 된 변경은 검사와 보고에 들어가지 않는다. 커밋된 HEAD ${target_sha:0:12}만 본다." >&2
      [[ $mode == fg ]] && mode=bg # 메인 체크아웃에서는 그 자리에서 검사하지 않는다
    fi
  fi
  if [[ $linked -eq 1 && "$message" == "[완료]"* ]]; then state="$("$check" --status)"; else state="$("$check" --status-of "$target_sha")"; fi
  grade="$(grade_of "$(task_of "$message")")"
  main_head="${main_head:-$(git -C "$(dirname "$common")" rev-parse HEAD)}"
  if [[ "$message" == "[병합완료]"* && ( "$state" == LIGHT\ * || "$state" == AFFECTED\ * ) ]]; then
    # 영향·경량 검사만 거친 SHA는 병합을 막지 않는다. 기본 브랜치의 전체 검사를 뒤에서 돌린다
    send "$message · $(state_label "$state") · 전체 검사는 뒤에서" || exit 1
    after_merge "$target_sha"
    exit 0
  fi
  base=""; [[ $linked -eq 1 && "$message" == "[완료]"* ]] && base="$main_head"
  if [[ "$grade" == 경량 && "$state" != PASS\ * && "$state" != UNSET ]]; then
    if [[ "$message" == "[완료]"* && $linked -eq 1 ]]; then
      over="$(light_over "$main_head")"
      if [[ -z "$over" ]]; then
        if [[ "$state" == LIGHT\ * ]]; then rc=0; else "$check" --light "$main_head"; rc=$?; fi
        case $rc in
          0) send "$message · 가벼운 검사 PASS $target_sha(경량)" || exit 1; exit 0 ;;
          3) send "$message · 가벼운 검사 미설정(경량, HERDR_CHECK_FILE_CMD 없음)" || exit 1; exit 0 ;;
          *) echo "경량 검사가 실패해 [완료]를 보내지 않았다. 고친 뒤 커밋하고 다시 보낸다." >&2; exit 1 ;;
        esac
      fi
      echo "경량 기준을 넘어 일반 관문(전체 검사)으로 보낸다: $over" >&2
      message="$message · 경량 기준 초과($over)"
    fi
  fi
  if [[ "$message" == "[완료]"* && "$grade" != 경량 && "$(verify_of "$(task_of "$message")")" == 필요 ]]; then
    # 독립 검증: 이 패치의 판정 PASS가 있어야 보낸다. 없으면 검사와 함께 뒤에서 검증 서브에이전트를 돌린다
    vstate="$("$BIN/herdr-verify" --status --sha "$target_sha" "$(task_of "$message")" 2>/dev/null)"
    case "$vstate" in
      PASS\ *) message="$message · $(verify_label "$vstate")" ;;
      ISSUES\ * | BLOCKED\ *)
        echo "이 패치는 독립 검증 ${vstate%% *}였다(기록 ${vstate##* }). 고쳐 커밋한 뒤 다시 보낸다. 지적이 틀렸다고 보면 herdr-verify --focus로 근거를 넘기고, 실행할 수 없으면 [차단]으로 올린다." >&2
        exit 1 ;;
      *)
        start_bg "$target_sha" "$base" verify
        [[ $linked -eq 1 ]] && echo "그동안 같은 묶음의 다음 작업을 이 커밋 위에서 이어 해도 된다. 이 커밋은 고치거나 rebase하지 않는다."
        exit 0 ;;
    esac
  fi
  case "$state" in
    UNSET) message="$message · 검사 미설정" ;;
    PASS\ * | AFFECTED\ *) message="$message · $(state_label "$state")" ;;
    *)
      if [[ $mode == bg || "$message" == "[병합완료]"* ]]; then
        start_bg "$target_sha" "$base"
        [[ "$message" == "[완료]"* && $linked -eq 1 ]] && echo "그동안 같은 묶음의 다음 작업을 이 커밋 위에서 이어 해도 된다. 이 커밋은 고치거나 rebase하지 않는다."
        exit 0
      fi
      if [[ -n "$base" ]]; then "$check" --affected "$base"; else "$check"; fi; rc=$?
      case $rc in
        0) message="$message · $(state_label "$("$check" --status)")" ;;
        3) message="$message · 검사 미설정" ;;
        *) echo "검사가 실패해 [완료]를 보내지 않았다. 고친 뒤 커밋하고 다시 보낸다. 고칠 수 없으면 [차단]으로 이유를 보낸다." >&2; exit 1 ;;
      esac
      ;;
  esac
elif [[ $mode == bg ]]; then
  echo "--bg는 워커의 [완료]에만 쓴다." >&2
  exit 2
fi
send "$message" || exit 1
