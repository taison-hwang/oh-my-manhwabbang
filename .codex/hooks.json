{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/.agents/hooks/check-edit.sh", "timeout": 120 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/.agents/hooks/worker-turn.sh start", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/.agents/hooks/worker-turn.sh stop", "timeout": 20 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/.agents/hooks/pre-compact.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/.agents/hooks/session-start.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
