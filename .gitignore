# ---- build output -----------------------------------------------------------
/dist/
web/dist/*
# .gitkeep stays committed so `//go:embed all:dist` matches on a clean checkout.
!web/dist/.gitkeep
web/node_modules/
node_modules/

# ---- derived data (NFR-DAT-001: the filesystem is the only source of truth) --
# graphify's knowledge graph: ~16 MB of graph.json/graph.html regenerated from
# the tree itself by `/graphify`, plus its per-file extraction cache.
/graphify-out/
*.db
*.db-wal
*.db-shm
*.db-journal
session.key

# ---- test and E2E scratch ---------------------------------------------------
/.e2e/
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/
/coverage.out
/docs/e2e-shots/
# The UI screenshot sets: ~52 MB of PNGs regenerated by the E2E rounds and by
# `make build`'s Playwright pass. They are review artefacts, not sources.
/docs/ui-shots/
# `make tidy` snapshots go.mod/go.sum here so it can roll back a tidy that would
# prune the frozen dependency set; they only survive a crash mid-target.
/.go.mod.bak
/.go.sum.bak

# ---- local configuration ----------------------------------------------------
# shelf.example.yaml is committed; the operator's real config is not.
/shelf.yaml
/shelf.*.yaml
!/shelf.example.yaml
/test/shelf.e2e.yaml

resources
graphify-out


# ---- __pycache__/ and *.pyc are deliberately NOT ignored ---------------------
# scripts/e2e-assert.py never produces them on its own: it runs as `__main__`
# (scripts/e2e.sh step 7) and CPython does not cache `__main__` — verified by
# running `python3 scripts/e2e-assert.py --help` on a clean tree and finding no
# `__pycache__`. They appear only when someone compiles or imports the file, and
# `python3 -m py_compile` writes one even under `-B`/PYTHONDONTWRITEBYTECODE,
# because those only govern the import machinery, not an explicit compile. Use
# `py_compile.compile(src, cfile=<somewhere outside the repo>, doraise=True)`.
#
# Ignoring them would be worse than not: scripts/e2e.sh step 9 fails the whole
# E2E on ANY file appearing under $repo after its marker, so a gitignore entry
# would hide the dirt from `git status` while leaving the gate to blow up later,
# with a message about the media volume rather than about a stray build
# artefact. An untracked file that shows up immediately is the earlier signal.

# ---- editor / OS --------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
